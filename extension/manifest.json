{
  "manifest_version": 3,
  "name": "Tor Connect",
  "version": "0.6.0",
  "description": "Route Chrome through a local Tor client.",
  "icons": {
    "16": "icons/disconnected-16.png",
    "32": "icons/disconnected-32.png",
    "48": "icons/disconnected-48.png",
    "128": "icons/disconnected-128.png"
  },
  "permissions": [
    "proxy",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://wikipedia.org/*",
    "https://*.wikipedia.org/*"
  ],
  "optional_permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png",
      "48": "icons/disconnected-48.png"
    },
    "default_title": "Tor Connect",
    "default_popup": "popup.html"
  }
}
